// Party Parcel data model.
// Dev datasource is SQLite for a zero-setup `npm run dev`.
// Swapping to Postgres for production is a datasource + DATABASE_URL change only —
// nothing here uses SQLite- or Postgres-only features (notably: no native `enum`, since D1's
// very limited ALTER TABLE support makes Prisma's enum-as-CHECK-constraint emulation risky to
// evolve later; `mode`/`status` are plain strings validated in src/server/rooms.ts instead).
// Verified against real Postgres 16 and against Cloudflare D1's local emulator.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id               String     @id @default(cuid())
  /// "room" | "solo" — see RoomMode in src/server/rooms.ts
  mode             String     @default("room")
  title            String
  celebrantName    String
  age              Int?
  occasion         String     @default("birthday")
  eventAt          DateTime
  timezone         String
  bannerText       String     @default("HAPPY BIRTHDAY!")
  hostEmail        String
  adminTokenHash   String     @unique
  contributeTokenHash String  @unique
  celebrateTokenHash  String  @unique
  /// "draft" | "live" | "deleted" — see RoomStatus in src/server/rooms.ts
  status           String     @default("draft")
  paidAt           DateTime?
  /// set when the host unlocks early; boxes are openable once now >= eventAt OR unlockedAt is set
  unlockedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  /// JSON-encoded RoomPermissions (contributor/celebrant decorating rights, freeze-layout) —
  /// see src/server/permissions.ts. Empty object means "defaults apply".
  permissionsJson  String     @default("{}")

  boxes            Box[]
  photoboothShots  PhotoboothShot[]
  payments         Payment[]
  objects          RoomObject[]
  customItems      CustomItem[]
}

/// One placed scene element — a wall frame, a plant, a light, a custom-drawn sticker, etc.
/// The room's entire visual layout is rows in this table, not hardcoded scene-builder code. A fresh room has none until first loaded, at which point
/// the server seeds the default layout (src/server/defaultLayout.ts) — see resolveRoomObjects().
model RoomObject {
  id                   String    @id @default(cuid())
  roomId               String
  room                 Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Catalog key from src/room/objectCatalog.ts (e.g. "sofa", "cake", "string-lights") — see
  /// RoomObjectKind in src/server/roomObjects.ts.
  kind                 String
  /// Set when this object renders a built-in procedural sprite (registry key into objectCatalog).
  spriteKey            String?
  /// Set when this object renders a room-library custom PNG/drawing instead (Phase 3).
  assetId              String?
  customItem           CustomItem? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  x                    Float
  y                    Float
  /// Explicit stacking order for non-floor zones (bring forward / send back). Floor-zone objects
  /// instead depth-sort by their own y at render time, regardless of this value — see
  /// buildScene.ts.
  z                    Int       @default(0)
  scale                Float     @default(1)
  flipX                Boolean   @default(false)
  /// Degrees: 0, 90, 180, or 270 — enforced in src/goodies/../roomObjectSchema.ts, not just here.
  rotation             Int       @default(0)
  /// "floor" | "wall" | "ceiling" | "tabletop" | "anywhere" — see RoomZone in roomObjects.ts.
  zone                 String
  locked               Boolean   @default(false)
  hidden               Boolean   @default(false)
  /// Per-kind extra config as JSON (cake style/candles/text, neon sign text, etc.).
  configJson           String    @default("{}")
  /// "admin" | "contribute" | "celebrate" — the role that placed/created this object.
  createdByRole        String
  /// Hash of the contributor's browser session token (see src/server/contributorSession.ts) —
  /// null for admin-created objects. Ownership for "own items only" permission checks.
  createdBySessionHash String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([roomId])
}

/// A room's "My items" library — imported PNGs and hand-drawn pixel art (Phase 3). Stored once,
/// placed as many RoomObjects as the room likes (RoomObject.assetId references this).
model CustomItem {
  id                   String       @id @default(cuid())
  roomId               String
  room                 Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  storageKey           String
  mime                 String
  width                Int
  height               Int
  size                 Int
  /// "import" | "drawing"
  source               String
  name                 String       @default("")
  createdByRole        String
  createdBySessionHash String?
  createdAt            DateTime     @default(now())

  objects              RoomObject[]

  @@index([roomId])
}

model Box {
  id              String    @id @default(cuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromName        String
  designJson      String
  posX            Float
  posY            Float
  z               Int       @default(0)
  /// Placement scale (Phase 4a) — multiplies the design's own S/M/L size. Bounded to
  /// LIMITS.minPresentScale..maxPresentScale by the PATCH route, not by this column.
  scale           Float     @default(1)
  /// Hash of the contributor browser session that packed it (Phase 4a) — ownership for the
  /// "canMoveOwnPresents" rule, same mechanism as RoomObject.createdBySessionHash. Null for boxes
  /// sealed before this column existed (only the host can move those).
  createdBySessionHash String?
  /// Phase 4b: when true the recipient must open the inner gifts in sort order.
  openInOrder     Boolean   @default(false)
  sealedAt        DateTime  @default(now())
  deleteTokenHash String
  openedAt        DateTime?
  reportedAt      DateTime?
  createdAt       DateTime  @default(now())

  goodies         Goodie[]
  gifts           Gift[]
  assets          Asset[]

  @@index([roomId])
}

/// One separately wrapped gift inside a box (Phase 4b). EVERY box has at least one: boxes sealed
/// before this table existed were backfilled with a single default gift holding all their goodies
/// (see the migration), and a single-gift box simply skips the inner-gift step for the recipient.
/// `label` and `designJson` are inner data — gated by the birthday lock exactly like goodie
/// payloads (only the contents route returns them).
model Gift {
  id         String   @id @default(cuid())
  boxId      String
  box        Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  sortOrder  Int
  label      String   @default("")
  /// The gift's own compact wrap design; "{}" for a default/single gift (it has no wrap of its own).
  designJson String   @default("{}")
  goodies    Goodie[]

  @@index([boxId])
}

model Goodie {
  id         String  @id @default(cuid())
  boxId      String
  box        Box     @relation(fields: [boxId], references: [id], onDelete: Cascade)
  /// Which inner gift this goodie is wrapped in (Phase 4b). Nullable only so a row written by
  /// anything that predates gifts can't violate the schema; every goodie the app creates has one.
  giftId     String?
  gift       Gift?   @relation(fields: [giftId], references: [id], onDelete: Cascade)
  type       String
  sortOrder  Int
  payloadJson String
  sizeBytes  Int

  redemption CouponRedemption?

  @@index([boxId])
}

model Asset {
  id         String @id @default(cuid())
  boxId      String
  box        Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  storageKey String
  mime       String
  size       Int
  sha256     String

  @@index([boxId])
}

model PhotoboothShot {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  storageKey      String
  caption         String
  deleteTokenHash String
  createdAt       DateTime @default(now())

  @@index([roomId])
}

model CouponRedemption {
  goodieId    String   @id
  goodie      Goodie   @relation(fields: [goodieId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  provider  String
  sessionId String
  amount    Int
  currency  String
  status    String
  createdAt DateTime @default(now())

  @@index([roomId])
}
