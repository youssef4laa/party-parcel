# Copy this file to `.env` and fill in real values. `.env` itself is gitignored.

# SQLite for local dev (zero setup). Point this at a Postgres URL for production —
# same Prisma schema, no code changes needed (the schema avoids native enums so it also stays
# portable to other SQL databases, including Cloudflare D1).
DATABASE_URL="file:./dev.db"

# Any long random string. Signs short-lived asset URLs (and, for local storage, upload URLs)
# server-side. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ASSET_SIGNING_SECRET=""

# "free" (instant success, for dev) or "stripe" (real Stripe Checkout).
PAYMENT_MODE="free"

# Price of a room, in cents, charged once when PAYMENT_MODE=stripe.
ROOM_PRICE_CENTS="100"

# Only required when PAYMENT_MODE=stripe (added in Milestone 7).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Only required once real email delivery is wired up (added in Milestone 7).
# RESEND_API_KEY=""

# "local" (default, disk-backed, dev) or "s3" (real S3/R2 bucket, needs the S3_* vars below).
STORAGE_PROVIDER="local"
# S3_ENDPOINT=""        # set for R2 / any non-AWS S3-compatible service; omit for real AWS S3
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Extra server-side image re-encode/EXIF-strip pass via `sharp`, on top of the browser-side
# processing every photo already goes through. `sharp` is a native Node addon that doesn't run
# on edge/Workers runtimes, so this defaults on for `next dev` and off in production — the
# browser-side pass is what production actually relies on. Force it either way if needed.
# ENABLE_SHARP_REENCODE="true"

# Free-tier limits (all enforced server-side; the UI just mirrors these numbers for counters).
# 50 goodies / 500MB per box is what we recommend for a paid tier —
# see RECOMMENDED_PAID_TIER in src/config/limits.ts.
NEXT_PUBLIC_MAX_GOODIES_PER_BOX="25"
NEXT_PUBLIC_MAX_BYTES_PER_BOX="26214400"
NEXT_PUBLIC_MAX_BYTES_PER_ROOM="209715200"
NEXT_PUBLIC_MAX_PHOTO_BYTES="10485760"
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES="20971520"
NEXT_PUBLIC_MAX_VOICE_SECONDS="180"

# Room Editor — every limit is an env var with the default shown.
# NEXT_PUBLIC_MAX_OBJECTS_PER_ROOM="300"
# NEXT_PUBLIC_MAX_ITEMS_PER_CONTRIBUTOR="10"
# NEXT_PUBLIC_MIN_OBJECT_SCALE="0.25"
# NEXT_PUBLIC_MAX_OBJECT_SCALE="4"
# Custom items (Phase 3): imported PNG/WebP and hand-drawn pixel art in the room's "My items" library.
# NEXT_PUBLIC_MAX_CUSTOM_ITEM_BYTES="524288"
# NEXT_PUBLIC_MAX_CUSTOM_ITEM_PX="512"
# NEXT_PUBLIC_MAX_CUSTOM_ITEMS_PER_ROOM="40"
# Presents and gifts (Phase 4): how far a placed present can be resized, and how many separately
# wrapped gifts one box can hold. (Per-box goodie/byte limits above apply to the box TOTAL.)
# NEXT_PUBLIC_MIN_PRESENT_SCALE="0.5"
# NEXT_PUBLIC_MAX_PRESENT_SCALE="3"
# NEXT_PUBLIC_MAX_GIFTS_PER_BOX="6"
