# Copy this file to `.env` and fill in real values. `.env` itself is gitignored.

# SQLite for local dev (zero setup). Point this at a Postgres URL for production —
# same Prisma schema, no code changes needed.
DATABASE_URL="file:./dev.db"

# Any long random string. Signs short-lived asset URLs server-side.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ASSET_SIGNING_SECRET=""

# "free" (instant success, for dev) or "stripe" (real Stripe Checkout).
PAYMENT_MODE="free"

# Price of a room, in cents, charged once when PAYMENT_MODE=stripe.
ROOM_PRICE_CENTS="100"

# Only required when PAYMENT_MODE=stripe (added in Milestone 7).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Only required once real email delivery is wired up (added in Milestone 7).
# RESEND_API_KEY=""
